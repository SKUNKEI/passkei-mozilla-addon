{
    "manifest_version": 3,
    "name": "PassKei by SKUNKEI",
    "version": "0.1.2",
    "description": "Securely fill and manage your PassKei vault credentials.",
    "browser_specific_settings": {
        "gecko": {
            "id": "passkei@skunkei.com",
            "strict_min_version": "142.0",
            "update_url": "https://static.skunkei.com/static/extensions/passkei/updates.json",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "icons": {
        "16": "icons/full-circle-16.png",
        "32": "icons/full-circle-32.png",
        "48": "icons/full-circle-48.png",
        "128": "icons/full-circle-128.png"
    },
    "background": {
        "scripts": ["src/background/background.js"],
        "type": "module"
    },
    "action": {
        "default_title": "PassKei",
        "default_popup": "src/popup/popup.html",
        "default_icon": {
            "32": "icons/full-circle-32.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "exclude_matches": ["*://*.mozilla.org/*"],
            "js": ["src/content/content.js"],
            "css": ["src/content/content.css"],
            "run_at": "document_idle",
            "all_frames": false
        }
    ],
    "permissions": ["storage", "cookies", "alarms", "activeTab", "scripting"],
    "host_permissions": ["https://api.skunkei.com/*", "https://pass.skunkei.com/*"],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}
